{
  "name": "ai-mc-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx server/index.ts",
    "start": "npm run build:web && tsx server/index.ts",
    "build:web": "vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "check-keys": "tsx scripts/check-keys.ts",
    "test": "tsx --test --test-timeout=20000 tests/*.test.ts",
    "build:guest": "vite build --config vite.guest.config.ts"
  },
  "dependencies": {
    "@livekit/rtc-node": "1.1.0",
    "dotenv": "17.2.3",
    "express": "5.3.0",
    "livekit-client": "2.22.4",
    "livekit-server-sdk": "2.19.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.19.15",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "6.1.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
